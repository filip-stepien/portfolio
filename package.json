{
    "name": "payload-blank",
    "version": "1.0.0",
    "description": "A blank template to get started with Payload 3.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
        "migrate:create": "cross-env POSTGRES_URL=postgres://localhost/unused NODE_OPTIONS=--no-deprecation payload migrate:create",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
        "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm run build"
    },
    "dependencies": {
        "@payloadcms/db-sqlite": "3.92.1",
        "@payloadcms/db-vercel-postgres": "3.92.1",
        "@payloadcms/next": "3.92.1",
        "@payloadcms/richtext-lexical": "3.92.1",
        "@payloadcms/ui": "3.92.1",
        "cross-env": "^7.0.3",
        "graphql": "^16.8.1",
        "next": "16.3.3",
        "payload": "3.92.1",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "sharp": "0.35.4"
    },
    "devDependencies": {
        "@types/node": "22.19.9",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.16.0",
        "eslint-config-next": "16.3.3",
        "prettier": "^3.4.2",
        "typescript": "5.7.3"
    },
    "engines": {
        "node": "^22.23.4 || >=24.22.1",
        "pnpm": "^9 || ^10 || ^11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp",
            "esbuild",
            "unrs-resolver"
        ]
    }
}
